{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make ci)",
      "Bash(make test)",
      "Bash(make security)",
      "Bash(make workflows)",
      "Bash(make clean)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff --cached)",
      "Bash(git ls-files)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh release list:*)",
      "Bash(gh label list:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/cratedeck/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh auth token:*)",
      "Bash(gh auth status --show-token:*)",
      "Bash(gh auth status -t:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)",
      "Bash(npx:*)",
      "Bash(npm exec:*)",
      "Bash(pnpm dlx:*)",
      "Bash(bunx:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_protected_push.py\"",
            "timeout": 10,
            "statusMessage": "Checking push target"
          }
        ]
      }
    ]
  }
}
